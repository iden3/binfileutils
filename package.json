{
  "name": "@iden3/binfileutils",
  "version": "0.0.12",
  "description": "Utils to work with iden3 binary files.",
  "type": "module",
  "exports": {
    ".": {
      "node": {
        "import": "./src/binfileutils.js",
        "require": "./build/main.cjs"
      },
      "browser": {
        "import": "./build/browser/browser.esm.js"
      },
      "default": "./src/binfileutils.js"
    }
  },
  "main": "./build/main.cjs",
  "module": "./src/binfileutils.js",
  "scripts": {
    "lint": "eslint .",
    "clean": "rimraf build",
    "pretest": "npm run build:node && npm run build:browser && npm run lint",
    "test": "vitest run",
    "test:node": "vitest run --project node-esm",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest --project node-esm",
    "build:node": "vite build",
    "build:browser": "vite build --mode browser",
    "build": "npm run clean && npm run build:node && npm run build:browser"
  },
  "repository": {
    "type": "git",
    "url": "https:https://github.com/iden3/binfileutils"
  },
  "keywords": [
    "file",
    "binary",
    "fastfile"
  ],
  "author": "Jordi Baylina",
  "license": "GPL-3.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/browser": "^4.1.2",
    "@vitest/browser-playwright": "^4.1.2",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "playwright": "^1.59.0",
    "rimraf": "^6.1.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "fastfile": "https://github.com/iden3/fastfile.git#feat/esm-migration",
    "ffjavascript": "https://github.com/iden3/ffjavascript.git#feat/esm-migration"
  }
}
